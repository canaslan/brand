    "400": {
      "$type": "string",
      "$value": "1.728rem"
    },
    "500": {
      "$type": "string",
      "$value": "2.074rem"
    },
    "600": {
      "$type": "string",
      "$value": "2.488rem"
    },
    "700": {
      "$type": "string",
      "$value": "2.986rem"
    }
